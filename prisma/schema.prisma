datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  CREATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SubscriptionPlan {
  FREE
  PAID
}

enum AssetStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum PromptFamily {
  CREATIVE
  DEVELOPMENT
}

enum PromptType {
  IMAGE
  VIDEO
  DEVELOPMENT
  CODING
  CREATIVE
  PRODUCTIVITY
  OTHER
}

enum AccessModel {
  FREE
  PAID
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String?
  googleId     String?          @unique
  name         String
  role         Role             @default(CREATOR)
  status       AccountStatus    @default(ACTIVE)
  plan         SubscriptionPlan @default(FREE)
  avatar       String?
  bio          String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  contextPacks  ContextPack[]
  prompts       Prompt[]         @relation("UserPrompts")
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model ContextPack {
  id                  String       @id @default(uuid())
  slug                String       @unique
  title               String
  shortDescription    String
  fullDescription     String?      @db.Text
  packVersion         String       @default("v1.0.0")
  schemaUri           String?
  targetPersona       String       @default("autonomous-agent")
  systemPrompt        String       @db.Text
  goldenRules         String?      @db.Text
  negativeConstraints String?      @db.Text
  supportedTools      String[]
  status              AssetStatus  @default(DRAFT)
  downloadsCount      Int          @default(0)
  rating              Float        @default(5.0)

  authorId            String
  author              User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  validationGates     ValidationGate[]
  files               PackFile[]

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("context_packs")
}

model ValidationGate {
  id            String      @id @default(uuid())
  gate          String
  enabled       Boolean     @default(true)
  contextPackId String
  contextPack   ContextPack @relation(fields: [contextPackId], references: [id], onDelete: Cascade)

  @@map("validation_gates")
}

model PackFile {
  id            String      @id @default(uuid())
  path          String
  description   String?
  fileType      String      @default("markdown")
  content       String      @db.Text
  contextPackId String
  contextPack   ContextPack @relation(fields: [contextPackId], references: [id], onDelete: Cascade)

  @@map("pack_files")
}

model Prompt {
  id               String        @id @default(uuid())
  slug             String        @unique
  title            String
  shortDescription String
  fullDescription  String?       @db.Text
  promptFamily     PromptFamily  @default(CREATIVE)
  promptType       PromptType    @default(IMAGE)
  
  // Core Image Prompt Content
  prompt           String        @db.Text
  negativePrompt   String?       @db.Text
  previewImageUrl  String?
  previewContent   String?       @db.Text

  // Image Generation Parameters (from context-pack)
  aiTool           String?       // Midjourney, Flux, Stable Diffusion, DALL-E 3, Ideogram
  model            String?       // e.g. Midjourney V7, Flux.1 Pro
  aspectRatio      String?       // e.g. 16:9, 1:1, 4:5, 9:16, 3:2
  style            String?       // e.g. Product Photography, Cinematic, Photorealistic
  useCase          String?       // e.g. Product Photography, Social Media, Advertising
  
  // Taxonomy & Discovery
  category         String        // Product, Portrait, Fashion, Architecture, Cinematic, etc.
  tags             String[]
  
  // Variations
  variations       PromptVariation[]

  // Access & Monetization
  accessType       AccessModel   @default(FREE)
  price            Float         @default(0.0)
  featured         Boolean       @default(false)
  
  // Lifecycle & Moderation
  status           AssetStatus   @default(DRAFT)
  adminFeedback    String?       @db.Text
  reviewedById     String?
  reviewedAt       DateTime?

  // SEO
  seoTitle         String?
  seoDescription   String?
  ogImageUrl       String?

  // Metrics
  viewsCount       Int           @default(0)
  downloadsCount   Int           @default(0)

  // Author Link
  authorId         String
  author           User          @relation("UserPrompts", fields: [authorId], references: [id], onDelete: Restrict)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([promptFamily, promptType, status])
  @@index([category, status])
  @@map("prompts")
}

model PromptVariation {
  id              String   @id @default(uuid())
  title           String   // e.g. "Front View", "45 Degree Angle"
  description     String?
  prompt          String   @db.Text
  previewImageUrl String?
  orderIndex      Int      @default(0)

  promptId        String
  promptRel       Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("prompt_variations")
}


